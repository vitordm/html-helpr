{
  "name": "vtr/html-helpr",
  "description": "Helper to create and manipulate HTML with PHP 8+",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Vítor G. I. Oliveira",
      "email": "oliveira.vitor3@gmail.com"
    }
  ],
  "require": {
    "php": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "Html\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Html\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "scripts": {
    "test": "./vendor/bin/phpunit --testdox tests",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "repositories": [
    {
      "type": "git",
      "url": "https://github.com/vitordm/htlml-helpr"
    }
  ]
}